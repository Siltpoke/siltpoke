# No trailing slash: ignores node_modules as a dir AND as a stray symlink-as-file.
# A `node_modules -> ./node_modules` self-loop was committed once because
# `node_modules/` (dir-only pattern) did not match the symlink → `git add -A` staged it.
node_modules
dist/
*.log
.DS_Store
.env
.env.*
*.tmp
.claude/settings.local.json
# `.siltpoke/*` (not `.siltpoke/`): a directory-level exclude makes git skip the
# dir entirely and the negation below could never re-include anything inside it.
.siltpoke/*
# …EXCEPT the authored C4 architecture model — versioned, reviewable docs-as-code
# (siltpoke-generate output), not machine-local state like the rest of .siltpoke/.
!.siltpoke/arch-c4.json

# generated by scripts/build-tokens.ts + scripts/build-client.ts
src/web/tokens/tokens.css
public/static/

# Playwright e2e artifacts (traces, screenshots, reports)
playwright-report/
test-results/
playwright/.cache/
tests/e2e/screenshots/
# Isolated daemon home used by e2e test runs (never pollutes real ~/.siltpoke)
.playwright-tmp/

# fastembed ONNX model cache (downloaded at runtime, ~100MB binaries)
local_cache/

# Local test-run marker (generated, not hand-written).
.claude/.last-test-run
# Ephemeral local scratch dirs.
.claude/worktrees/

# Machine-local eval data — encodes machine-local absolute paths
src/eval/caller-impact/local-picks.json
src/eval/caller-impact/frozen-manifest.json
src/eval/caller-impact/lean-manifest.json
