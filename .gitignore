# No trailing slash: ignores node_modules as a dir AND as a stray symlink-as-file.
# A `node_modules -> ./node_modules` self-loop was committed once because
# `node_modules/` (dir-only pattern) did not match the symlink → `git add -A` staged it.
node_modules
*.log
.DS_Store
.env
.env.*
*.tmp
.claude/settings.local.json
# `.siltpoke/*` (not `.siltpoke/`): a directory-level exclude makes git skip the
# dir entirely and the negation below could never re-include anything inside it.
.siltpoke/*
# …EXCEPT the authored C4 architecture model — versioned, reviewable docs-as-code
# (siltpoke-generate output), not machine-local state like the rest of .siltpoke/.
!.siltpoke/arch-c4.json

# generated by scripts/build-tokens.ts + scripts/build-client.ts
src/web/tokens/tokens.css
# public/static/ holds BUILD OUTPUT, but two of its files are RUNTIME ASSETS the
# published package must contain — the daemon serves them and the dashboard is
# inert without them. They are committed on purpose, the same way dist/ is, and
# `bun run check:client` byte-compares them against a fresh build so they cannot
# drift. Everything else here (kanban-*.js and friends) stays ignored.
#
# This exception exists because they were NOT committed: index.js carries
# Alpine.js plus 31 interaction islands, was never tracked, and so the published
# package answered 503 for it — every dashboard interaction dead on every host.
# tailwind.css reached the public repo only by someone remembering `git add -f`;
# nobody remembered index.js. See an internal design note [0].
# NOTE the trailing `*`: `public/static/` (directory form) excludes the directory
# itself, and git then never descends into it, so a later `!` exception can never
# re-include anything. `public/static/*` excludes the CONTENTS, which the `!`
# lines below can then carve out.
public/static/*
!public/static/index.js
!public/static/tailwind.css

# Playwright e2e artifacts (traces, screenshots, reports)
playwright-report/
test-results/
playwright/.cache/
tests/e2e/screenshots/
# Isolated daemon home used by e2e test runs (never pollutes real ~/.siltpoke)
.playwright-tmp/

# fastembed ONNX model cache (downloaded at runtime, ~100MB binaries)
local_cache/

# Native (.node) addons that Bun.build can pull into dist/ if a bundle ever
# forgets to mark a native-backed dep (e.g. fastembed's @anush008/tokenizers)
# external. These are always platform-specific (Darwin/Linux/Windows) and
# must never be committed — the plugin repo is cross-platform. Backstop only;
# scripts/build-dist.ts's `external` list is the real fix (see BundleSpec).
dist/**/*.node

# Local test-run marker (generated, not hand-written).
.claude/.last-test-run
# Ephemeral local scratch dirs.
.claude/worktrees/

# Machine-local eval data — encodes machine-local absolute paths
src/eval/caller-impact/local-picks.json
src/eval/caller-impact/frozen-manifest.json
src/eval/caller-impact/lean-manifest.json

# Guided-smoke screenshot artifacts (local only)
test-screenshots/

# agy plugin-native self-contained copies — build-generated by
# scripts/build-dist.ts (copyAgyPluginSelfContained), duplicated from
# hooks/agy-stop.sh + dist/agy-stop.js + the repo-root skills/ tree. Not
# source; .antigravity-plugin/ plugin.json + hooks.json (the hand-authored
# manifest) stay tracked.
.antigravity-plugin/hooks/
.antigravity-plugin/dist/
.antigravity-plugin/skills/

# superpowers brainstorm visual-companion scratch (mockups, not source)
.superpowers/

# Python bytecode — a helper script runs on every session open, so its .pyc
# regenerates constantly. One was tracked once and showed up as a spurious diff
# on every render.
__pycache__/
*.pyc

# Audit-harness eyeball dumps — regenerated on every re-run, not evidence.
# (The evidence is the committed *-output.txt snapshots.)

# CI writes this so a failing unit run leaves a readable artifact behind; it is
# also what you get if you run the workflow's test command by hand locally.
unit-test.log

# PLC per-phase working state (session-scoped, never committed)
/.claude/tasklist.md
.codex-plugin/skills/
