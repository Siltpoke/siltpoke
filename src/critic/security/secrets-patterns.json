{
  "patterns": [
    { "id": "aws-access-key", "regex": "AKIA[0-9A-Z]{16}", "description": "AWS Access Key ID" },
    { "id": "aws-secret-key", "regex": "(?i)aws(.{0,20})?(?:secret|priv).{0,40}?['\"]([A-Za-z0-9/+]{40})['\"]", "description": "AWS Secret Access Key" },
    { "id": "github-pat", "regex": "ghp_[A-Za-z0-9]{36}", "description": "GitHub Personal Access Token" },
    { "id": "github-oauth", "regex": "gho_[A-Za-z0-9]{36}", "description": "GitHub OAuth Token" },
    { "id": "stripe-secret", "regex": "sk_(?:live|test)_[A-Za-z0-9]{24,99}", "description": "Stripe API Key" },
    { "id": "slack-token", "regex": "xox[baprs]-[A-Za-z0-9-]+", "description": "Slack Token" },
    { "id": "google-api", "regex": "AIza[0-9A-Za-z\\-_]{35}", "description": "Google API Key" },
    { "id": "anthropic-api", "regex": "sk-ant-[A-Za-z0-9_-]{32,}", "description": "Anthropic API Key" },
    { "id": "openai-api", "regex": "sk-(?:proj-)?[A-Za-z0-9]{32,}", "description": "OpenAI API Key" },
    { "id": "generic-private-key", "regex": "-----BEGIN (RSA|DSA|EC|OPENSSH|PRIVATE) KEY-----", "description": "Private Key Block" },
    { "id": "jwt-token", "regex": "eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}", "description": "JWT Token" },
    { "id": "high-entropy-base64", "regex": "['\"]([A-Za-z0-9+/]{40,}={0,2})['\"]", "description": "Possible base64-encoded secret" }
  ]
}
