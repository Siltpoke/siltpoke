{
  "name": "siltpoke",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "description": "A sassy ASCII terminal buddy that reviews Claude Code's work",
  "scripts": {
    "test": "bun test",
    "setup": "bun src/cli/install.ts",
    "uninstall": "bun src/cli/uninstall.ts",
    "edit-personality": "bun src/cli/first-run.ts",
    "first-run": "bun src/cli/first-run.ts",
    "stats": "bun src/cli/stats.ts",
    "face": "bun src/face/wrapper.ts",
    "test-brain": "bun run scripts/test-brain.ts",
    "migrate-critiques": "bun run scripts/migrate-critiques-per-project.ts",
    "report": "bun src/cli/report.ts",
    "report:stop": "bun src/cli/report-stop.ts",
    "daemon": "bun src/cli/daemon.ts",
    "siltpoke-daemon": "bun src/cli/daemon.ts",
    "build:tokens": "bun scripts/build-tokens.ts",
    "dev:web": "bun scripts/dev-web.ts",
    "build:tailwind": "tailwindcss -i src/web/tokens/tailwind.css -o public/static/tailwind.css --minify",
    "build:tailwind:watch": "tailwindcss -i src/web/tokens/tailwind.css -o public/static/tailwind.css --watch",
    "build:client": "bun scripts/build-client.ts --minify",
    "build:web": "bun scripts/build-tokens.ts && bun run build:tailwind && bun scripts/build-client.ts --minify",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "lint": "biome lint src/ tests/ scripts/",
    "lint:fix": "biome lint --write src/ tests/ scripts/",
    "lint:func": "bun scripts/lint-func-length.ts",
    "lint:files": "bun scripts/lint-file-length.ts",
    "audit:dead": "knip --no-progress",
    "audit:dup": "jscpd src --min-tokens 50 --min-lines 5 --reporters consoleFull",
    "audit:cycles": "dpdm --exit-code circular:1 src/cli/daemon.ts src/hooks/handle-stop.ts src/cli/report.ts",
    "audit:arch": "depcruise --config .dependency-cruiser.cjs src",
    "eval": "bun scripts/eval-run.ts",
    "eval:fast": "bun scripts/eval-run.ts --fast",
    "test:coverage": "bun test --coverage",
    "test:coverage:check": "bun test --coverage 2>&1 | tee /tmp/cov.txt && (grep -E 'All files.*\\| ([0-9]+\\.?[0-9]*)' /tmp/cov.txt | awk -F'|' '{print $4}' | awk '{ gsub(/^ +| +$/,\"\"); if ($1 < 80) { print \"Coverage \" $1 \" < 80 threshold\"; exit 1 } else { print \"Coverage \" $1 \" OK\" } }')"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.10.2",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/cli": "^4.3.1",
    "@types/alpinejs": "^3.13.11",
    "@types/bun": "latest",
    "@types/shell-quote": "^1.7.5",
    "@types/sortablejs": "^1.15.9",
    "dependency-cruiser": "^17.4.0",
    "dpdm": "^4.2.0",
    "eslint": "^10.4.0",
    "jscpd": "^4.2.3",
    "knip": "^6.14.1",
    "tailwindcss": "^4.3.1",
    "ts-morph": "^28.0.0",
    "typescript-eslint": "^8.59.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@nanostores/alpine": "^0.1.1",
    "alpinejs": "^3.15.12",
    "better-sqlite3": "^12.10.0",
    "fastembed": "^2.1.0",
    "hono": "^4.12.18",
    "marked": "^18.0.3",
    "nanostores": "^1.3.0",
    "shell-quote": "^1.8.3",
    "sortablejs": "^1.15.7",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.9",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
