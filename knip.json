{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/cli/*.ts",
    "src/hooks/*.ts",
    "src/daemon/server.ts",
    "src/web/client/index.ts",
    "scripts/*.ts",
    "tests/**/*.test.ts",
    "tests/**/*.test.tsx",
    "tests/e2e/*.spec.ts",
    "tests/knowledge/fixtures/run-render-cache-bundle-build.ts",
    "tests/knowledge/fixtures/render-cache-bundle-entry.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "tests/**/*.{ts,tsx}"
  ],
  "ignore": [
    "local_cache/**",
    ".playwright-tmp/**",
    "**/*.preview.tsx",
    "tests/eval/repo-graph-state/fixture-repo/**"
  ],
  "ignoreDependencies": [
    "@types/*"
  ]
}
